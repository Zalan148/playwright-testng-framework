<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Functional Tests" parallel="classes" thread-count="5">
    <test name="Chromium" parallel="classes" thread-count="5" verbose="2">
        <classes>
            <!-- UI Tests -->
            <class name="com.example.framework.tests.CartTest"/>
            <class name="com.example.framework.tests.CheckoutTest"/>
            <class name="com.example.framework.tests.InventoryTest"/>
            <class name="com.example.framework.tests.LoginTest"/>

            <!-- API Smoke Tests -->
            <class name="com.example.tests.smoke.ApiSmokeTest"/>
            <class name="com.example.tests.smoke.DataFactorySmokeTest"/>
            <class name="com.example.tests.smoke.EnvironmentSmokeTest"/>

            <!-- Hybrid Tests -->
            <class name="com.example.tests.hybrid.HybridLoginBypassTest"/>
            <class name="com.example.tests.hybrid.HybridOrderFlowTest"/>
            <class name="com.example.tests.hybrid.HybridProductFlowTest"/>
            <class name="com.example.tests.hybrid.HybridUserFlowTest"/>
        </classes>
    </test>
</suite>